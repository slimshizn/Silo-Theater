<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="repository.silo.theater" name="Silo Theater Repository" version="1.0.1" provider-name="slimshizn">
    <requires>
      <import addon="xbmc.addon" version="12.0.0" />
    </requires>
    <extension point="xbmc.addon.repository" name="Silo Theater Repository">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/slimshizn/Silo-Theater/gh-pages/addons.xml</info>
        <checksum verify="md5">https://raw.githubusercontent.com/slimshizn/Silo-Theater/gh-pages/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/slimshizn/Silo-Theater/gh-pages/zips/</datadir>
        <hashes>sha256</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Install and update Silo Theater for Kodi</summary>
      <description lang="en_GB">The Silo Theater add-on repository provides installation packages and updates for Silo Theater.</description>
      <license>AGPL-3.0-or-later</license>
      <platform>all</platform>
    </extension>
  </addon>
  <addon id="script.silo" name="Silo" version="0.2.0" provider-name="slimshizn">
    <requires>
      <import addon="xbmc.python" version="3.0.1" />
      <import addon="xbmc.gui" version="5.17.0" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">A native Silo experience for Kodi</summary>
      <description lang="en_GB">Browse your Silo library, choose a media file and resume movies and episodes from your saved position. Customize playback and browsing for your Kodi device.</description>
      <disclaimer lang="en_GB">Select HDR and Dolby Vision settings that your device and display support.</disclaimer>
      <license>AGPL-3.0-or-later</license>
      <platform>all</platform>
    </extension>
  </addon>
</addons>

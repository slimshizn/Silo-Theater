<?xml version="1.0" encoding="UTF-8"?>
<!-- Sign-in form driven by login.prompt_login. Control IDs 101-103 and 201-203 and the
     silo.allow_code / silo.allow_password / silo.sign_in_label / silo.login_message
     properties are part of that controller's contract. Button 204 ("Create an account",
     ui_people.create_account) shows only while silo.allow_signup is set. -->
<window type="dialog">
  <defaultcontrol always="true">101</defaultcontrol>
  <coordinates><system>1</system><width>1920</width><height>1080</height></coordinates>
  <controls>
    <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FF000000">white.png</texture></control>
    <control type="image"><left>480</left><top>270</top><width>1440</width><height>810</height><aspectratio>stretch</aspectratio><texture>brand_light.png</texture></control>
    <control type="image"><left>0</left><top>0</top><width>960</width><height>1080</height><texture colordiffuse="FF000000">scrim_left.png</texture></control>
    <control type="image"><left>90</left><top>60</top><width>52</width><height>52</height><aspectratio>keep</aspectratio><texture>app_mark.png</texture></control>
    <control type="label"><left>166</left><top>60</top><width>520</width><height>52</height><aligny>center</aligny><font>font36_title</font><textcolor>FFEDEDED</textcolor><label>Founders Theater</label></control>

    <control type="label"><left>90</left><top>390</top><width>900</width><height>80</height><aligny>center</aligny><font>font52_title</font><textcolor>FFEDEDED</textcolor><label>Sign in to Silo</label></control>
    <control type="textbox"><left>90</left><top>486</top><width>820</width><height>120</height><font>font27</font><textcolor>BFEDEDED</textcolor><label>Use your Silo account, or approve a sign-in code from another device.</label></control>

    <control type="group">
      <left>1050</left><top>187</top>
      <control type="image"><left>0</left><top>0</top><width>780</width><height>706</height><texture border="42" colordiffuse="FF1F1F1F">glass.png</texture><visible>String.IsEmpty(Window.Property(silo.allow_signup))</visible></control>
      <control type="image"><left>0</left><top>0</top><width>780</width><height>790</height><texture border="42" colordiffuse="FF1F1F1F">glass.png</texture><visible>!String.IsEmpty(Window.Property(silo.allow_signup))</visible></control>

      <control type="label"><left>56</left><top>52</top><width>668</width><height>34</height><aligny>center</aligny><font>font12</font><textcolor>BFEDEDED</textcolor><label>Silo server</label></control>
      <control type="edit" id="101">
        <left>52</left><top>92</top><width>676</width><height>84</height>
        <font>font27</font><textcolor>FFEDEDED</textcolor><focusedcolor>FFEDEDED</focusedcolor><disabledcolor>66EDEDED</disabledcolor>
        <textoffsetx>28</textoffsetx><aligny>center</aligny><label></label>
        <texturefocus border="30">field_focus.png</texturefocus><texturenofocus border="30">field.png</texturenofocus>
        <onup>203</onup><ondown condition="!String.IsEmpty(Window.Property(silo.allow_password))">102</ondown><ondown>201</ondown>
      </control>

      <control type="label"><left>56</left><top>196</top><width>668</width><height>34</height><aligny>center</aligny><font>font12</font><textcolor>BFEDEDED</textcolor><label>Username</label></control>
      <control type="edit" id="102">
        <left>52</left><top>236</top><width>676</width><height>84</height>
        <font>font27</font><textcolor>FFEDEDED</textcolor><focusedcolor>FFEDEDED</focusedcolor><disabledcolor>66EDEDED</disabledcolor>
        <textoffsetx>28</textoffsetx><aligny>center</aligny><label></label>
        <texturefocus border="30">field_focus.png</texturefocus><texturenofocus border="30">field.png</texturenofocus>
        <onup>101</onup><ondown>103</ondown>
        <enable>!String.IsEmpty(Window.Property(silo.allow_password))</enable>
      </control>

      <control type="label"><left>56</left><top>340</top><width>668</width><height>34</height><aligny>center</aligny><font>font12</font><textcolor>BFEDEDED</textcolor><label>Password</label></control>
      <control type="edit" id="103">
        <left>52</left><top>380</top><width>676</width><height>84</height>
        <font>font27</font><textcolor>FFEDEDED</textcolor><focusedcolor>FFEDEDED</focusedcolor><disabledcolor>66EDEDED</disabledcolor>
        <textoffsetx>28</textoffsetx><aligny>center</aligny><label></label>
        <texturefocus border="30">field_focus.png</texturefocus><texturenofocus border="30">field.png</texturenofocus>
        <onup>102</onup><ondown>201</ondown>
        <enable>!String.IsEmpty(Window.Property(silo.allow_password))</enable>
      </control>

      <control type="textbox"><left>56</left><top>480</top><width>668</width><height>72</height><font>font12</font><textcolor>FFFFB4A8</textcolor><label>$INFO[Window.Property(silo.login_message)]</label></control>

      <control type="button" id="201">
        <left>52</left><top>578</top><width>200</width><height>76</height>
        <label>$INFO[Window.Property(silo.sign_in_label)]</label><font>font25_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFEDEDED</textcolor><focusedcolor>FF000000</focusedcolor>
        <texturefocus border="38" colordiffuse="FFEDEDED">pill76.png</texturefocus><texturenofocus border="38">pill76_idle.png</texturenofocus>
        <onleft>203</onleft><onright condition="!String.IsEmpty(Window.Property(silo.allow_code))">202</onright><onright condition="String.IsEmpty(Window.Property(silo.allow_code))">203</onright>
        <onup condition="!String.IsEmpty(Window.Property(silo.allow_password))">103</onup><onup>101</onup><ondown condition="!String.IsEmpty(Window.Property(silo.allow_signup))">204</ondown><ondown>101</ondown>
      </control>
      <control type="button" id="202">
        <left>268</left><top>578</top><width>284</width><height>76</height>
        <label>Use a sign-in code</label><font>font25_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFEDEDED</textcolor><focusedcolor>FF000000</focusedcolor>
        <texturefocus border="38" colordiffuse="FFEDEDED">pill76.png</texturefocus><texturenofocus border="38">pill76_idle.png</texturenofocus>
        <onleft>201</onleft><onright>203</onright>
        <onup condition="!String.IsEmpty(Window.Property(silo.allow_password))">103</onup><onup>101</onup><ondown condition="!String.IsEmpty(Window.Property(silo.allow_signup))">204</ondown><ondown>101</ondown>
        <visible>!String.IsEmpty(Window.Property(silo.allow_code))</visible>
      </control>
      <control type="button" id="203">
        <left>568</left><top>578</top><width>160</width><height>76</height>
        <label>Cancel</label><font>font25_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFEDEDED</textcolor><focusedcolor>FF000000</focusedcolor>
        <texturefocus border="38" colordiffuse="FFEDEDED">pill76.png</texturefocus><texturenofocus border="38">pill76_idle.png</texturenofocus>
        <onleft condition="!String.IsEmpty(Window.Property(silo.allow_code))">202</onleft><onleft>201</onleft><onright>201</onright>
        <onup condition="!String.IsEmpty(Window.Property(silo.allow_password))">103</onup><onup>101</onup><ondown condition="!String.IsEmpty(Window.Property(silo.allow_signup))">204</ondown><ondown>101</ondown>
      </control>
      <control type="button" id="204">
        <left>52</left><top>682</top><width>676</width><height>76</height>
        <label>Create an account</label><font>font25_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFEDEDED</textcolor><focusedcolor>FF000000</focusedcolor>
        <texturefocus border="38" colordiffuse="FFEDEDED">pill76.png</texturefocus><texturenofocus border="38">pill76_idle.png</texturenofocus>
        <onup>201</onup><ondown>101</ondown>
        <visible>!String.IsEmpty(Window.Property(silo.allow_signup))</visible>
      </control>
    </control>

    <control type="label"><left>90</left><top>990</top><width>1400</width><height>30</height><aligny>center</aligny><font>font10</font><textcolor>80EDEDED</textcolor><label>Founders Theater is a community add-on for Silo, not an official Silo app.</label></control>
  </controls>
</window>

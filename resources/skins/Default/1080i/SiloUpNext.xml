    <control type="image">
      <left>1168</left><top>732</top><width>320</width><height>180</height>
      <texture border="16" colordiffuse="FF15171C">round16.png</texture>
    </control>
    <control type="image">
      <left>1168</left><top>732</top><width>320</width><height>180</height>
      <aspectratio>scale</aspectratio><fadetime>200</fadetime>

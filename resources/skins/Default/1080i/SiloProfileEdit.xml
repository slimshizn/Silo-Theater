<?xml version="1.0" encoding="UTF-8"?>
<!-- Edit or add one profile. ui_people.ProfileEditWindow fills list 500 with one row per field
     (label, label2 = value) and sets silo.heading, silo.name, silo.avatar, silo.initials,
     silo.note, silo.message and silo.can_delete. 601 Save, 602 Cancel, 603 Delete. -->
<window type="dialog">
  <defaultcontrol always="true">500</defaultcontrol>
  <coordinates><system>1</system><width>1920</width><height>1080</height></coordinates>
  <controls>
    <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FF000000">white.png</texture></control>
    <control type="image"><left>480</left><top>270</top><width>1440</width><height>810</height><aspectratio>stretch</aspectratio><texture>brand_light.png</texture></control>
    <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="D9000000">white.png</texture></control>
    <control type="image"><left>90</left><top>60</top><width>100</width><height>52</height><aspectratio>keep</aspectratio><texture>silo_wordmark.png</texture></control>
    <control type="label"><left>214</left><top>60</top><width>400</width><height>52</height><aligny>center</aligny><font>font36_title</font><textcolor>FFEDEDED</textcolor><label>Theater</label></control>

    <control type="label"><left>88</left><top>168</top><width>1744</width><height>72</height><aligny>center</aligny><font>font52_title</font><textcolor>FFEDEDED</textcolor><label>$INFO[Window.Property(silo.heading)]</label></control>

    <!-- Avatar and name of the profile as it will be saved. -->
    <control type="image"><left>152</left><top>300</top><width>220</width><height>220</height><texture colordiffuse="FF15171C">circle.png</texture></control>
    <control type="label"><left>152</left><top>300</top><width>220</width><height>220</height><align>center</align><aligny>center</aligny><font>font52_title</font><textcolor>FFEDEDED</textcolor><label>$INFO[Window.Property(silo.initials)]</label></control>
    <control type="image"><left>152</left><top>300</top><width>220</width><height>220</height><aspectratio>scale</aspectratio><texture diffuse="mask_circle.png" background="true">$INFO[Window.Property(silo.avatar)]</texture></control>
    <control type="label"><left>88</left><top>540</top><width>348</width><height>44</height><align>center</align><aligny>center</aligny><font>font30_title</font><textcolor>FFEDEDED</textcolor><label>$INFO[Window.Property(silo.name)]</label></control>
    <control type="textbox"><left>88</left><top>600</top><width>440</width><height>200</height><font>font12</font><textcolor>BFEDEDED</textcolor><label>$INFO[Window.Property(silo.note)]</label></control>

    <control type="list" id="500">
      <left>630</left><top>300</top><width>1080</width><height>532</height>
      <orientation>vertical</orientation>
      <scrolltime tween="cubic" easing="out">200</scrolltime>
      <onup>500</onup><ondown>601</ondown><onleft>500</onleft><onright>601</onright>
      <itemlayout width="1080" height="76">
        <control type="label"><left>24</left><top>0</top><width>620</width><height>76</height><aligny>center</aligny><font>font27</font><textcolor>FFEDEDED</textcolor><label>$INFO[ListItem.Label]</label></control>
        <control type="label"><left>480</left><top>0</top><width>576</width><height>76</height><align>right</align><aligny>center</aligny><font>font27</font><textcolor>BFEDEDED</textcolor><label>$INFO[ListItem.Label2]</label></control>
      </itemlayout>
      <focusedlayout width="1080" height="76">
        <control type="image"><left>0</left><top>0</top><width>1080</width><height>76</height><texture border="16" colordiffuse="FFEDEDED">round16.png</texture><visible>Control.HasFocus(500)</visible></control>
        <control type="image"><left>0</left><top>0</top><width>1080</width><height>76</height><texture border="16" colordiffuse="24FFFFFF">round16.png</texture><visible>!Control.HasFocus(500)</visible></control>
        <control type="label"><left>24</left><top>0</top><width>620</width><height>76</height><aligny>center</aligny><font>font27</font><textcolor>FF000000</textcolor><label>$INFO[ListItem.Label]</label><visible>Control.HasFocus(500)</visible></control>
        <control type="label"><left>24</left><top>0</top><width>620</width><height>76</height><aligny>center</aligny><font>font27</font><textcolor>FFEDEDED</textcolor><label>$INFO[ListItem.Label]</label><visible>!Control.HasFocus(500)</visible></control>
        <control type="label"><left>480</left><top>0</top><width>576</width><height>76</height><align>right</align><aligny>center</aligny><font>font27</font><textcolor>B3000000</textcolor><label>$INFO[ListItem.Label2]</label><visible>Control.HasFocus(500)</visible></control>
        <control type="label"><left>480</left><top>0</top><width>576</width><height>76</height><align>right</align><aligny>center</aligny><font>font27</font><textcolor>BFEDEDED</textcolor><label>$INFO[ListItem.Label2]</label><visible>!Control.HasFocus(500)</visible></control>
      </focusedlayout>
    </control>

    <control type="textbox"><left>654</left><top>846</top><width>1032</width><height>40</height><font>font12</font><textcolor>FFFFB4A8</textcolor><label>$INFO[Window.Property(silo.message)]</label></control>

    <control type="button" id="601">
      <left>630</left><top>900</top><width>200</width><height>76</height>
      <label>Save</label><font>font25_title</font><align>center</align><aligny>center</aligny>
      <textcolor>FFEDEDED</textcolor><focusedcolor>FF000000</focusedcolor>
      <texturefocus border="38" colordiffuse="FFEDEDED">pill76.png</texturefocus><texturenofocus border="38">pill76_idle.png</texturenofocus>
      <onup>500</onup><ondown>500</ondown><onleft>500</onleft><onright>602</onright>
    </control>
    <control type="button" id="602">
      <left>846</left><top>900</top><width>200</width><height>76</height>
      <label>Cancel</label><font>font25_title</font><align>center</align><aligny>center</aligny>
      <textcolor>FFEDEDED</textcolor><focusedcolor>FF000000</focusedcolor>
      <texturefocus border="38" colordiffuse="FFEDEDED">pill76.png</texturefocus><texturenofocus border="38">pill76_idle.png</texturenofocus>
      <onup>500</onup><ondown>500</ondown><onleft>601</onleft>
      <onright condition="!String.IsEmpty(Window.Property(silo.can_delete))">603</onright><onright>601</onright>
    </control>
    <control type="button" id="603">
      <left>1062</left><top>900</top><width>280</width><height>76</height>
      <label>Delete profile</label><font>font25_title</font><align>center</align><aligny>center</aligny>
      <textcolor>FFEDEDED</textcolor><focusedcolor>FF000000</focusedcolor>
      <texturefocus border="38" colordiffuse="FFEDEDED">pill76.png</texturefocus><texturenofocus border="38">pill76_idle.png</texturenofocus>
      <onup>500</onup><ondown>500</ondown><onleft>602</onleft><onright>601</onright>
      <visible>!String.IsEmpty(Window.Property(silo.can_delete))</visible>
    </control>

    <control type="label"><left>90</left><top>1006</top><width>1400</width><height>30</height><aligny>center</aligny><font>font10</font><textcolor>80EDEDED</textcolor><label>Silo Theater is a community add-on for Silo, not an official Silo app.</label></control>
  </controls>
</window>
